generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleId     String?  @unique @map("google_id")
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String?  @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  authProvider String   @default("local") @map("auth_provider")

  groupsCreated    Group[]            @relation("GroupCreator")
  memberships      GroupMember[]      @relation("GroupMember")
  expensesPaid     Expense[]          @relation("ExpensePaid")
  expenseShares    ExpenseShare[]     @relation("ExpenseShare")
  paymentsSent     Payment[]          @relation("PaymentsSent")
  paymentsReceived Payment[]          @relation("PaymentsReceived")
  notifications    Notification[]
  joinRequests     GroupJoinRequest[] @relation("UserJoinRequests")
  reviewedRequests GroupJoinRequest[] @relation("ReviewerJoinRequests")

  @@map("users")
}

model Group {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String   @db.VarChar(100)
  createdById          String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  joinApprovalRequired Boolean  @default(false) @map("join_approval_required")
  inviteCode           String   @unique @map("invite_code") // kode unik per grup

  creator      User          @relation("GroupCreator", fields: [createdById], references: [id])
  
  groupPayment Payment[]     @relation("InterGroupPayment")
  members      GroupMember[]
  expenses     Expense[]
  joinRequests GroupJoinRequest[]

  @@map("groups")
}

model GroupMember {
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member") @db.VarChar(20)
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation("GroupMember", fields: [userId], references: [id])

  @@id([groupId, userId])
  @@map("group_members")
}

model Expense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  paidBy      String   @map("paid_by") @db.Uuid
  description String
  totalAmount Decimal  @db.Decimal(14, 2)
  expenseDate DateTime @map("expense_date")
  createdAt   DateTime @default(now()) @map("created_at")

  group      Group          @relation(fields: [groupId], references: [id])
  paidByUser User           @relation("ExpensePaid", fields: [paidBy], references: [id])
  
  shares     ExpenseShare[]

  @@map("expenses")
}

model ExpenseShare {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseId   String    @map("expense_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  shareAmount Decimal   @map("share_amount") @db.Decimal(14, 2)
  isPaid      Boolean   @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at")

  expense    Expense @relation(fields: [expenseId], references: [id])
  user       User    @relation("ExpenseShare", fields: [userId], references: [id])

  allocations PaymentAllocation[]

  @@map("expense_shares")
}

// Satu Payment = satu transfer uang dari fromUser ke toUser.
// Share yang dilunasi transfer ini dicatat di PaymentAllocation, sehingga satu transfer
// bisa menutup banyak share sekaligus, termasuk share dua arah (settle up / lunasi selisih).
model Payment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId        String?   @map("group_id") @db.Uuid // Saya buat opsional (ada ?) jika suatu saat ada pelunasan di luar grup
  fromUser       String    @map("from_user") @db.Uuid
  toUser         String    @map("to_user") @db.Uuid
  amount         Decimal   @db.Decimal(14, 2) // nominal yang benar-benar ditransfer (selisih bersih)
  note           String
  status         String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  submittedAt    DateTime  @default(now()) @map("submitted_at")
  reviewedAt     DateTime? @map("reviewed_at") // null sampai di-acc/tolak
  rejectionNote  String?   @map("rejection_note") // alasan kalau ditolak

  from          User         @relation("PaymentsSent", fields: [fromUser], references: [id])
  to            User         @relation("PaymentsReceived", fields: [toUser], references: [id])
  groupActivity Group?       @relation("InterGroupPayment", fields: [groupId], references: [id])
  allocations   PaymentAllocation[]

  @@index([toUser, status])
  @@map("payments")
}

// Baris penghubung Payment <-> ExpenseShare.
// Invariant (dijaga partial unique index di migration, bukan di Prisma schema):
//   satu share hanya boleh punya SATU alokasi aktif (payment pending/approved).
//   Saat payment ditolak, alokasinya di-set active = false sehingga share bisa diajukan lagi.
model PaymentAllocation {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId      String  @map("payment_id") @db.Uuid
  expenseShareId String  @map("expense_share_id") @db.Uuid
  amount         Decimal @db.Decimal(14, 2) // nominal share yang ditutup
  active         Boolean @default(true)

  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  expenseShare ExpenseShare @relation(fields: [expenseShareId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([expenseShareId])
  @@map("payment_allocations")
}

model GroupJoinRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  status      String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  requestedAt DateTime  @default(now()) @map("requested_at")
  reviewedAt  DateTime? @map("reviewed_at")
  
  group       Group     @relation(fields: [groupId], references: [id])
  user        User      @relation("UserJoinRequests", fields: [userId], references: [id])
  reviewer    User?     @relation("ReviewerJoinRequests", fields: [reviewedBy], references: [id])
  
  @@map("group_join_requests")
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  type        String   @db.VarChar(50)
  message     String
  isRead      Boolean  @default(false) @map("is_read")
  referenceId String?  @map("reference_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}